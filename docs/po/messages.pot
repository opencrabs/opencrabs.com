msgstr ""

#: src/getting-started/onboarding.md:113
msgid "Wait for your confirmation"
msgstr ""

#: src/getting-started/onboarding.md:114
msgid "Execute the migration and report a full breakdown"
msgstr ""

#: src/getting-started/onboarding.md:116
msgid "Autonomous Migration"
msgstr ""

#: src/getting-started/onboarding.md:118
msgid "If you just want it done:"
